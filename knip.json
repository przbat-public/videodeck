{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "duplicates": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "server": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["yt-dlp"]
    },
    "client": {
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "src/__tests__/**/*.{ts,tsx}"],
      "entry": ["vitest.integration.config.ts", "src/__tests__/integration/setup.ts"]
    },
    "chrome-extension": {
      "entry": ["src/content.ts", "src/popup.ts", "src/options.ts"],
      "project": ["src/**/*.ts"]
    },
    "test-infra": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
