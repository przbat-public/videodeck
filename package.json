{
  "name": "video-search-app",
  "version": "1.0.0",
  "description": "YouTube video search application with yt-dlp support",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install && cd ../chrome-extension && npm install",
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:extension": "cd chrome-extension && npm run build",
    "lint": "biome check . && node scripts/check-hardcoded-polish.mjs && node scripts/check-tsconfig-strict.mjs",
    "lint:types": "eslint . --max-warnings 0",
    "lint:fix": "biome check --write .",
    "lint:scripts": "tsc -p scripts/tsconfig.json",
    "test:scripts": "node --test scripts/*.test.mjs",
    "knip": "knip",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs server client chrome-extension shared",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "cd server && npm run typecheck && cd ../client && npm run typecheck && cd ../chrome-extension && npm run typecheck",
    "test": "cd server && npm run test && cd ../client && npm run test:run && cd ../chrome-extension && npm test",
    "test:watch": "cd server && npm run test:watch",
    "test:coverage": "cd server && npm run test:coverage && cd ../client && npm run test:coverage",
    "test:e2e": "cd client && npm run test:e2e",
    "prepare": "husky",
    "install:ci": "npm ci && npm ci --prefix server && npm ci --prefix client && npm ci --prefix chrome-extension"
  },
  "packageManager": "npm@10.9.3",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^3.25.76"
  },
  "private": true
}
