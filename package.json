{
  "name": "video-search-app",
  "version": "1.0.0",
  "description": "YouTube video search application with yt-dlp support",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{client/src,server/src,shared,chrome-extension}/**/*.{ts,tsx,js,json,css}\"",
    "format:check": "prettier --check \"{client/src,server/src,shared,chrome-extension}/**/*.{ts,tsx,js,json,css}\"",
    "typecheck": "cd server && npm run typecheck && cd ../client && npm run typecheck",
    "test": "cd server && npm run test && cd ../client && npm run test:run",
    "test:watch": "cd server && npm run test:watch",
    "test:coverage": "cd server && npm run test:coverage && cd ../client && npm run test:coverage"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
