{
  "name": "video-search-app",
  "version": "1.0.0",
  "description": "YouTube video search application with yt-dlp support",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install && cd ../chrome-extension && npm install",
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:extension": "cd chrome-extension && npm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"{client/src,server/src,shared}/**/*.{ts,tsx,js,json,css}\" \"chrome-extension/src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"{client/src,server/src,shared}/**/*.{ts,tsx,js,json,css}\" \"chrome-extension/src/**/*.{ts,json}\"",
    "typecheck": "cd server && npm run typecheck && cd ../client && npm run typecheck && cd ../chrome-extension && npm run typecheck",
    "test": "cd server && npm run test && cd ../client && npm run test:run && cd ../chrome-extension && npm test",
    "test:watch": "cd server && npm run test:watch",
    "test:coverage": "cd server && npm run test:coverage && cd ../client && npm run test:coverage",
    "test:e2e": "cd client && npm run test:e2e",
    "prepare": "husky",
    "install:ci": "npm ci && npm ci --prefix server && npm ci --prefix client && npm ci --prefix chrome-extension"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "private": true
}
