{
  "name": "video-search-client",
  "version": "1.0.0",
  "description": "Frontend (React + Vite) of video-search-app: search, video details, channel status page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.integration.json",
    "test:e2e": "playwright test",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@videodeck/shared": "workspace:*",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.9.5",
    "react-window": "^2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@videodeck/test-infra": "workspace:*"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
