# Nginx template for the client image. The container entrypoint runs envsubst
# over /etc/nginx/templates/*.template and writes the result to conf.d; only
# variables that exist in the environment are substituted, so the nginx
# variables below ($host, $uri, ...) are left alone.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing: let React Router handle unknown paths
    location / {
        # No other site may show these pages in a frame. Inside one, the UI's
        # requests carry its own Origin, so the server cannot tell a click a
        # hostile page arranged from one the user meant. Only here: a location
        # that declares an add_header drops the ones it would inherit, and at
        # server level these would double what helmet sends on /api answers.
        # frame-ancestors alone on purpose: a default-src would block the
        # inline theme script in index.html and the style tags the toast and
        # menu libraries add at runtime. Never send Referrer-Policy no-referrer
        # from here: the UI's own writes would then carry Origin null, which the
        # server refuses on plain HTTP.
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }

    # The image's healthcheck asks here. nginx answers by itself, without the
    # static files or the upstream, and the probe stays out of the log.
    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        # The server writes a line for every API request already, and this
        # log would add the query string it leaves out on purpose: a folder
        # path or a search phrase. The price is the cross-site 403 below,
        # which now leaves no line anywhere. The page and its assets stay
        # logged.
        access_log off;
        # Browsers mark a request cross-site only on loopback and HTTPS
        # addresses. The server refuses those on its own, and answering here
        # keeps them from reaching it at all. On a plain-HTTP LAN address there
        # is no marker, and the server judges the Origin instead, against the
        # X-Forwarded-Host below. Clients that send no header (curl, the
        # extension worker) pass here.
        if ($http_sec_fetch_site = "cross-site") {
            return 403;
        }
        proxy_pass http://server:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The address the browser used, port included ($host drops it). With no
        # Sec-Fetch-Site the server takes a write only from a page whose Origin
        # is this address, a host in ALLOWED_HOSTS or a trusted origin. Host
        # stays $host: the server's Host check reads it.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # The server trusts one hop (TRUST_PROXY=1 in the compose stack) and
        # reads the client address from this header. Without it the rate limit
        # counts every browser in one bucket, and a client that sets the header
        # itself is believed. $proxy_add_x_forwarded_for appends the real peer.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The browser never sees the API token: this container holds it and
        # adds it here. Without it the UI answered 401 against the compose
        # default of REQUIRE_API_TOKEN=true. An empty token sends an empty
        # bearer value, which the server ignores while it runs open on
        # loopback.
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        # SSE for the extension's download stream
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
