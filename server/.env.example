# Environment configuration for the video-search-app server.
# Copy to `.env`, fill in real values and restrict the file (`chmod 600 .env`):
# it holds the API token and the OpenAI key, and `.env` is gitignored but
# world-readable by default. Never commit it.

# One or more channel folders (semicolon/comma separated). Segments may
# contain `*` (one path level), e.g. /Volumes/MEDIA/* or ~/Videos/youtube.
VIDEOS_FOLDER_PATH=/path/to/videos

# Elasticsearch endpoint (defaults to http://localhost:9200)
ELASTICSEARCH_URL=http://localhost:9200

# OpenAI API key for AI summaries (GET /api/videos/:id/summary). Optional —
# without it the summary endpoint returns an error.
OPENAI_API_KEY=sk-REPLACE-ME

# Optional: bearer token guarding /api (recommended for LAN access)
# API_TOKEN=change-me

# Optional: refuse open mode. With this set and API_TOKEN empty every /api
# request is answered 401 instead of running unauthenticated; the Docker stack
# sets it by default. Pair it with API_TOKEN, or the UI cannot talk to the
# server at all.
# REQUIRE_API_TOKEN=true

# Optional: bind address (default 127.0.0.1)
# HOST=127.0.0.1

# Optional: server port (default 3001)
# PORT=3001

# Optional: extra CORS origins, comma separated (localhost and the Chrome
# extension scheme are always allowed)
# CORS_ORIGINS=

# Optional: extra Host-header allowlist entries for LAN setups (see README)
# ALLOWED_HOSTS=

# Optional: exact chrome-extension://<id> origins allowed by CORS
# EXTENSION_ORIGINS=

# Optional: download queue tuning
# DOWNLOAD_CONCURRENCY=2
# UPDATE_CONCURRENCY=2
# DOWNLOAD_MAX_ATTEMPTS=3

# Optional: HTTP rate limit (requests per window per IP)
# RATE_LIMIT_MAX=2000
# RATE_LIMIT_WINDOW_MS=600000

# Optional: how many proxies in front of the server may declare the client IP
# (Express "trust proxy": a hop count like 1, "loopback", or a subnet). The
# rate limit counts per IP, so behind nginx every request otherwise shares one
# bucket. Leave it unset when the server is reached directly: a client could
# then spoof the header.
# TRUST_PROXY=1

# Optional: log level: info | warn | error | silent (default info)
# LOG_LEVEL=info
