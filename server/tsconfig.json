{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "rootDir": "..",
    "outDir": "./dist",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@videodeck/test-infra/*": ["../test-infra/src/*"]
    },
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    // Each file is type-checked standalone (fast, catches re-exports that
    // would break bundlers). verbatimModuleSyntax stays off on purpose:
    // without "type": "module" the server compiles ../shared as CommonJS,
    // where that flag forbids top-level exports (TS1287).
    "isolatedModules": true
  },
  "include": ["src/**/*", "../shared/**/*", "../test-infra/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
