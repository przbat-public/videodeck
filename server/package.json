{
  "name": "video-search-server",
  "version": "1.0.0",
  "description": "Backend (Express + Elasticsearch) of video-search-app: video search, yt-dlp download queue, AI summaries",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch --exclude '.queue-state.json' --exclude '.queue-state.json.*' src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "RUN_ES_INTEGRATION=1 jest src/services/elasticsearch.integration.test.ts",
    "test:ytdlp-integration": "RUN_YTDLP_INTEGRATION=1 jest src/services/ytdlp.integration.test.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@prometheus-io/client": "^0.16.1",
    "@videodeck/shared": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "openai": "^7.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "@videodeck/test-infra": "workspace:*",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
