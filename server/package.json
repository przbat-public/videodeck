{
  "name": "video-search-server",
  "version": "1.0.0",
  "description": "Backend (Express + Elasticsearch) aplikacji video-search-app: wyszukiwanie filmów, kolejka pobierania yt-dlp, podsumowania AI",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "RUN_ES_INTEGRATION=1 jest src/services/elasticsearch.integration.test.ts",
    "test:ytdlp-integration": "RUN_YTDLP_INTEGRATION=1 jest src/services/ytdlp.integration.test.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "openai": "^7.15.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.3",
    "fast-check": "^4.10.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
