{
  "default_locale": "pl",
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "1.0.0",
  "description": "__MSG_manifestDescription__",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "action": {
  "default_locale": "pl",
    "default_popup": "popup.html",
    "default_icon": {
  "default_locale": "pl",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
  "default_locale": "pl",
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
  "default_locale": "pl",
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
  "default_locale": "pl",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
