node_modules/
dist/
*.log
.DS_Store
.eslintcache
coverage/
.nyc_output/
*.lcov

# Environment files: the example is tracked, real values never are
.env
.env.*
!.env.example
*.local
*.pem

# TypeScript incremental build state
*.tsbuildinfo

# Vite cache
.vite/

# Chrome extension build output (generated by chrome-extension: npm run build)
chrome-extension/*.js

# shared/ is types-only; an accidental tsc emit must never be committed
shared/*.js

# Playwright
client/playwright-report/
client/test-results/

# Server-side download queue state (runtime persistence; cwd = server/)
server/.queue-state.json
