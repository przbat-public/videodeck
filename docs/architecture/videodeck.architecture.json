    "views": [
      {
        "id": "search-path",
        "label": "Search path",
        "focus": ["browser", "server", "es"],
        "note": "The primary path: query the Elasticsearch index and render results."
      },
      {
        "id": "download-path",
        "label": "Download path",
        "focus": ["extension", "server", "queue", "ytdlp", "videos", "es"],
        "note": "Enqueue, download with yt-dlp and reindex the new files."
      },
      {
        "id": "summary-path",
        "label": "Summary path",
        "focus": ["browser", "server", "openai"],
        "note": "AI summaries generated on demand and cached."
      }
    ]
  },
  "components": [
    {
      "id": "browser",
      "type": "frontend",
      "label": "React client",
      "sublabel": "vite :3000",
